{
  "name": "chaoscomputerclub",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "root",
    "organization/*"
  ],
  "scripts": {
    "dev": "npm --prefix root run dev",
    "build": "npm --prefix root run build",
    "preview": "npm --prefix root run preview",
    "dev:root": "npm --prefix root run dev",
    "dev:medicaps": "npm --prefix organization/Medicaps.chaoscomputerclub.in run dev",
    "build:root": "npm --prefix root run build",
    "build:medicaps": "npm --prefix organization/Medicaps.chaoscomputerclub.in run build",
    "build:all": "npm run build:root && npm run build:medicaps",
    "dev:backend": "cd organization/Medicaps.chaoscomputerclub.in/backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:medicaps:all": "npm run dev:backend & npm run dev:medicaps"
  }
}
